-- Schema version 1. SQL is intentionally standard SQLite so it can also be
-- checked without Flutter. Dates are local ISO days; timestamps are UTC millis.
-- Media bytes live in managed files, never in SQLite BLOB columns.

CREATE TABLE personal_roles (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  description TEXT NOT NULL DEFAULT '',
  position INTEGER NOT NULL DEFAULT 0 CHECK (position >= 0)
);

CREATE TABLE personal_values (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL CHECK (length(trim(title)) > 0),
  description TEXT NOT NULL DEFAULT '',
  position INTEGER NOT NULL DEFAULT 0 CHECK (position >= 0)
);

CREATE TABLE goals (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL CHECK (length(trim(title)) > 0),
  description TEXT NOT NULL DEFAULT '',
  role_id TEXT REFERENCES personal_roles(id) ON DELETE SET NULL,
  horizon TEXT NOT NULL DEFAULT 'short' CHECK (horizon IN ('short', 'long')),
  target_day TEXT,
  status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'completed', 'archived')),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL CHECK (updated_at >= created_at)
);

CREATE TABLE goal_milestones (
  id TEXT NOT NULL PRIMARY KEY,
  goal_id TEXT NOT NULL REFERENCES goals(id) ON DELETE CASCADE,
  title TEXT NOT NULL CHECK (length(trim(title)) > 0),
  target_day TEXT,
  completed_at INTEGER,
  position INTEGER NOT NULL DEFAULT 0 CHECK (position >= 0)
);

CREATE TABLE planner_tasks (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL CHECK (length(trim(title)) > 0),
  description TEXT NOT NULL DEFAULT '',
  planned_day TEXT NOT NULL CHECK (length(planned_day) = 10),
  original_day TEXT NOT NULL CHECK (length(original_day) = 10),
  priority TEXT NOT NULL DEFAULT 'B' CHECK (priority IN ('A', 'B', 'C')),
  position INTEGER NOT NULL DEFAULT 0 CHECK (position >= 0),
  status TEXT NOT NULL DEFAULT 'not_started'
    CHECK (status IN ('not_started', 'in_progress', 'completed', 'forwarded', 'delegated', 'canceled')),
  delegate_name TEXT NOT NULL DEFAULT '',
  goal_id TEXT REFERENCES goals(id) ON DELETE SET NULL,
  recurrence_rule TEXT,
  recurrence_series_id TEXT,
  occurrence_day TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL CHECK (updated_at >= created_at),
  completed_at INTEGER,
  CHECK ((status = 'completed' AND completed_at IS NOT NULL)
      OR (status <> 'completed' AND completed_at IS NULL)),
  CHECK ((recurrence_series_id IS NULL AND occurrence_day IS NULL)
      OR (recurrence_series_id IS NOT NULL AND occurrence_day IS NOT NULL)),
  UNIQUE (recurrence_series_id, occurrence_day)
);

CREATE TABLE task_status_history (
  id TEXT NOT NULL PRIMARY KEY,
  task_id TEXT NOT NULL REFERENCES planner_tasks(id) ON DELETE CASCADE,
  from_status TEXT NOT NULL,
  to_status TEXT NOT NULL,
  from_day TEXT NOT NULL,
  to_day TEXT NOT NULL,
  changed_at INTEGER NOT NULL,
  operation_id TEXT NOT NULL UNIQUE
);

CREATE TABLE appointments (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL CHECK (length(trim(title)) > 0),
  description TEXT NOT NULL DEFAULT '',
  start_at INTEGER NOT NULL,
  end_at INTEGER NOT NULL CHECK (end_at > start_at),
  all_day INTEGER NOT NULL DEFAULT 0 CHECK (all_day IN (0, 1)),
  recurrence_rule TEXT,
  recurrence_series_id TEXT,
  occurrence_day TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL CHECK (updated_at >= created_at),
  CHECK ((recurrence_series_id IS NULL AND occurrence_day IS NULL)
      OR (recurrence_series_id IS NOT NULL AND occurrence_day IS NOT NULL)),
  UNIQUE (recurrence_series_id, occurrence_day)
);

CREATE TABLE daily_notes (
  day TEXT NOT NULL PRIMARY KEY CHECK (length(day) = 10),
  content TEXT NOT NULL DEFAULT '',
  updated_at INTEGER NOT NULL
);

CREATE TABLE journal_entries (
  id TEXT NOT NULL PRIMARY KEY,
  entry_day TEXT NOT NULL CHECK (length(entry_day) = 10),
  title TEXT NOT NULL DEFAULT '',
  rich_text_json TEXT NOT NULL DEFAULT '[{"insert":"\n"}]',
  plain_text TEXT NOT NULL DEFAULT '',
  category TEXT NOT NULL DEFAULT '',
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL CHECK (updated_at >= created_at)
);

CREATE TABLE journal_tags (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL COLLATE NOCASE UNIQUE CHECK (length(trim(name)) > 0)
);

CREATE TABLE journal_entry_tags (
  entry_id TEXT NOT NULL REFERENCES journal_entries(id) ON DELETE CASCADE,
  tag_id TEXT NOT NULL REFERENCES journal_tags(id) ON DELETE CASCADE,
  PRIMARY KEY (entry_id, tag_id)
);

-- Deleting a linked task/appointment removes only its link, never the entry.
CREATE TABLE journal_task_links (
  entry_id TEXT NOT NULL REFERENCES journal_entries(id) ON DELETE CASCADE,
  task_id TEXT NOT NULL REFERENCES planner_tasks(id) ON DELETE CASCADE,
  PRIMARY KEY (entry_id, task_id)
);

CREATE TABLE journal_appointment_links (
  entry_id TEXT NOT NULL REFERENCES journal_entries(id) ON DELETE CASCADE,
  appointment_id TEXT NOT NULL REFERENCES appointments(id) ON DELETE CASCADE,
  PRIMARY KEY (entry_id, appointment_id)
);

CREATE TABLE journal_attachments (
  id TEXT NOT NULL PRIMARY KEY,
  entry_id TEXT NOT NULL REFERENCES journal_entries(id) ON DELETE CASCADE,
  kind TEXT NOT NULL CHECK (kind IN ('image', 'document', 'audio')),
  display_name TEXT NOT NULL CHECK (length(trim(display_name)) > 0),
  relative_path TEXT NOT NULL UNIQUE,
  mime_type TEXT NOT NULL,
  size_bytes INTEGER NOT NULL CHECK (size_bytes >= 0),
  duration_ms INTEGER CHECK (duration_ms IS NULL OR duration_ms >= 0),
  caption TEXT NOT NULL DEFAULT '',
  position INTEGER NOT NULL DEFAULT 0 CHECK (position >= 0),
  created_at INTEGER NOT NULL,
  CHECK (relative_path LIKE 'media/%' AND instr(relative_path, '..') = 0
    AND instr(relative_path, char(92)) = 0 AND instr(relative_path, ':') = 0)
);

-- A durable deletion queue permits file cleanup after a committed DB delete.
-- The multimedia service will drain and reconcile this queue in milestone 5.
CREATE TABLE pending_file_deletions (
  relative_path TEXT NOT NULL PRIMARY KEY,
  queued_at INTEGER NOT NULL,
  CHECK (relative_path LIKE 'media/%' AND instr(relative_path, '..') = 0
    AND instr(relative_path, char(92)) = 0 AND instr(relative_path, ':') = 0)
);

CREATE TRIGGER queue_attachment_file_deletion
BEFORE DELETE ON journal_attachments
BEGIN
  INSERT OR IGNORE INTO pending_file_deletions (relative_path, queued_at)
  VALUES (old.relative_path, CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TABLE weekly_plans (
  week_start_day TEXT NOT NULL PRIMARY KEY CHECK (length(week_start_day) = 10),
  priorities TEXT NOT NULL DEFAULT '',
  review TEXT NOT NULL DEFAULT '',
  updated_at INTEGER NOT NULL
);

CREATE TABLE weekly_plan_goals (
  week_start_day TEXT NOT NULL REFERENCES weekly_plans(week_start_day) ON DELETE CASCADE,
  goal_id TEXT NOT NULL REFERENCES goals(id) ON DELETE CASCADE,
  PRIMARY KEY (week_start_day, goal_id)
);

CREATE TABLE monthly_plans (
  month TEXT NOT NULL PRIMARY KEY CHECK (length(month) = 7),
  master_tasks TEXT NOT NULL DEFAULT '',
  review TEXT NOT NULL DEFAULT '',
  updated_at INTEGER NOT NULL
);

CREATE TABLE monthly_plan_goals (
  month TEXT NOT NULL REFERENCES monthly_plans(month) ON DELETE CASCADE,
  goal_id TEXT NOT NULL REFERENCES goals(id) ON DELETE CASCADE,
  PRIMARY KEY (month, goal_id)
);

CREATE TABLE reminders (
  id TEXT NOT NULL PRIMARY KEY,
  notification_id INTEGER NOT NULL UNIQUE CHECK (notification_id >= 0),
  task_id TEXT REFERENCES planner_tasks(id) ON DELETE CASCADE,
  appointment_id TEXT REFERENCES appointments(id) ON DELETE CASCADE,
  kind TEXT NOT NULL CHECK (kind IN ('task', 'appointment', 'daily_planning', 'daily_review')),
  scheduled_at INTEGER NOT NULL,
  enabled INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)),
  CHECK ((kind = 'task' AND task_id IS NOT NULL AND appointment_id IS NULL)
    OR (kind = 'appointment' AND appointment_id IS NOT NULL AND task_id IS NULL)
    OR (kind IN ('daily_planning', 'daily_review') AND task_id IS NULL AND appointment_id IS NULL))
);

CREATE TABLE app_settings (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE tutorial_progress (
  lesson_id TEXT NOT NULL PRIMARY KEY,
  completed_at INTEGER,
  last_step INTEGER NOT NULL DEFAULT 0 CHECK (last_step >= 0),
  updated_at INTEGER NOT NULL
);

CREATE INDEX tasks_by_day_priority ON planner_tasks(planned_day, priority, position, id);
CREATE INDEX task_history_by_task ON task_status_history(task_id, changed_at);
CREATE INDEX appointments_by_time ON appointments(start_at, end_at);
CREATE INDEX journals_by_day ON journal_entries(entry_day, created_at);
CREATE INDEX attachments_by_entry ON journal_attachments(entry_id, position);
CREATE INDEX goals_by_role ON goals(role_id, status);
